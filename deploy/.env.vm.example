# openGym on a GCP VM behind a Cloudflare tunnel.
#   cp deploy/.env.vm.example .env   — then fill in the blanks.
# See .env.example for every other option.

# ── Public hostname the app is served on ───────────────────────────────────
# The Cloudflare tunnel's public hostname. Passkeys bind to this exact host —
# changing it later invalidates every registered passkey.
RP_ID=opengym.example.com
ORIGIN=https://opengym.example.com
RP_NAME=openGym
WEB_PORT=8080

# ── Cloudflare tunnel ──────────────────────────────────────────────────────
# Token of a remotely-managed tunnel (Zero Trust → Networks → Tunnels → your
# tunnel → Configure → "Install and run a connector" — the long token in the
# command shown, or rotate it to get a fresh one).
TUNNEL_TOKEN=

# ── MCP endpoint shared secret ─────────────────────────────────────────────
# Clients must send  Authorization: Bearer <key>  (or X-API-Key).
# Generate:  openssl rand -hex 32
MCP_API_KEY=

# Optional — auto-detected when the instance has exactly one profile.
# Multi-user instances: pick the uid in ./data/db.json under users[].id.
# OPENGYM_UID=

# ── Cloudflare is genuinely in front → let the audit log see real IPs ──────
# $$ escapes to a literal $ so the nginx variable reaches the template intact.
CF_CONNECTING_IP=$$http_cf_connecting_ip

# ── Suggested hardening for a public instance ──────────────────────────────
# No "continue without account" button:
ALLOW_GUEST=0
# After your profile exists and your uid is in ADMIN_UIDS, lock signup down:
# INVITE_ONLY=1
# ADMIN_UIDS=your-uid-from-db.json
# Password sign-in next to passkeys (recovery path):
# PASSWORD_LOGIN=1

# Default language for the sign-in screen and new profiles:
DEFAULT_LANG=pt-BR
